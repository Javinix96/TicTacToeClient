:root {
}

.background-container {
    background-image: url("project://database/Assets/Imgs/RoomsImgs/Panel.png#RoomPanel");
    width: 100%;
    height: 230px;
    margin-bottom: 10px;
    flex-direction: row;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
}

.icon-container {
    width: 26%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.room-info{
    flex-grow:1;
    justify-content: space-between;
    flex-direction: column;
    height: 77%;
    margin-top: 15px;
}

.box{
    justify-content: space-between;
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
}

.icon-label{
    background-image: url("project://database/Assets/ui/Menu/svg/users.svg");
    height: 70%;
    width: 20%;
}

.icon-host{
    background-image: url("project://database/Assets/ui/Menu/svg/crown1.svg");
    height: 70%;
    width: 20%;
}

.profile-img{
    background-image: url("project://database/Assets/ui/Menu/svg/cross.svg");
    width: 50%;
    height: 50%;
    margin-left: 24px;
}

.players-cont{
    justify-content: space-between;
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
}


.ms{
    width: 35%;
}

.arrow{
    width: 7%;
}

.info{
    color:white;
    font-size: 24px;
    padding: 0;
    margin:0;
    height: 70%;
}
