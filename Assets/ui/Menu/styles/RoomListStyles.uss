.container {
    background-color: rgb(11, 18, 32);
    padding: 12px;
    flex-grow: 1;
    width: 100%;
    background-image: url("project://database/Assets/Imgs/BackGround.png?fileID=-1009002845499871143&guid=ac926d1156de47f4e84a9836f5ddbe0b&type=3#Tablero futurista de tic-tac-toe_0");
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    align-items: center;
    height: 20%;
}

.title {
    font-size: 75px;
    color: white;
    unity-font-style: bold;
    align-self: center;
    text-align: center;
}

.btn-exit {
    background-color: rgb(255, 77, 77);
    color: white;
    border-radius: 26px;
    font-size: 68px;
    /* padding: 6px 12px; */
    width: 30%;
    height: 50%;
    align-self: center;
    margin-right: 10px;
}

.section {
    border-radius: 42px;
    padding: 5px;
    margin-bottom: 10px;
    height: 85%;
    border-width: 1px;
    border-color: rgba(255, 255, 255,0.1);
    padding: 10px;
    background-image: url("project://database/Assets/Imgs/Panel.png?fileID=2800000&guid=ac3bd113b4e45154c93414a7d5a7ea1b&type=3#Panel");
}

.rooms-container{
    height: 100%;
    margin: 85px;
    font-size: 48px;
}

.room-list {
    flex-grow: 1;
}

.room-item {
    background-color: rgb(26, 36, 64);
    margin-bottom: 6px;
    padding: 8px;
    border-radius: 8px;
    flex-direction: row;
    justify-content: space-between;
}

.room-name {
    color: white;
}

.room-status {
    color: rgb(0, 255, 153);
}

.section2 {
    border-radius: 42px;
    padding: 1px;
    margin-bottom: 10px;
    height: 85%;
    border-width: 1px;
    border-color: rgba(255, 255, 255,0.1);
    /* background-image: url("project://database/Assets/Imgs/Panel.png?fileID=2800000&guid=ac3bd113b4e45154c93414a7d5a7ea1b&type=3#Panel"); */
}

.info {
    height: 8%;
    overflow: hidden;
    flex-grow: 1;   
    flex-direction: row;
    border-width: 0;
}

.info-cont{
    justify-content: space-around;
    height: 100%;
    width: 75%;
    flex-grow: 1;  
}

.icon-cont
{
    flex-grow: 1;
    justify-content:center;
    align-items:center;
}
.search{
    height: 92%;
    font-size: 50px;
    border-width: 0;
}

.search TextInput{
    border-width: 0;
    color: white;
    background-color: rgba(32, 35, 48, 0.9);
    background-image: url("project://database/Assets/Imgs/Border.png#Input");
}

.search-img{
    background-image: url("project://database/Assets/ui/Menu/svg/search.svg");
    width: 80%;
    height: 85%;
}

.info-l{
    color: rgb(207, 216, 255);
    padding: 2px;
    font-size: 40px;
}

.section-title {
    color: rgb(110, 168, 255);
    margin-bottom: 15px;
    unity-font-style: bold;
    font-size: 60px;
}
.bottom{
    height: 12%;
    flex-direction:row;
    justify-content: space-evenly;
    margin:20px;
}

.btn-create {
    background-color: rgba(45, 108, 223,0);
    color: white;
    margin-bottom: 6px;
    margin-left: 30px;
    margin-right: 30px;
    width:49%;
    flex-direction: row;
    border-width: 0;
    background-image: url("project://database/Assets/Imgs/RoomsImgs/RoomsButtons.png#create");
}

.btn-create:hover {
    background-image: url("project://database/Assets/Imgs/RoomsImgs/RoomsButtons.png#createPush");
}

.btn-join {
    background-color: rgba(46, 204, 113,0);
    color: white;
    width:48%;
    margin-right: 30px;
    border-width: 0;
    background-image: url("project://database/Assets/Imgs/RoomsImgs/RoomsButtons.png#join2");
}

.btn-join:hover{
    background-image: url("project://database/Assets/Imgs/RoomsImgs/RoomsButtons.png#join2Push");
}


.room-list >  .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical{
    display:none;
}

.room-list >  .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical > *{
    display:none;
}

.exit-img{
    background-image: url("project://database/Assets/Imgs/ButtonAnim.png#Close");
    width: 20%;
    height: 60%;
    margin-right: 50px;
    margin-top: 20px;
}

.exit-img:hover{
    background-image: url("project://database/Assets/Imgs/ButtonAnim.png#ClosePush");
}