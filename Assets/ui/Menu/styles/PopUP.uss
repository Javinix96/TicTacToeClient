:root {
    flex-grow: 1;
}

.overlay {
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);

}



.card {
    width: 80%;
    height: 50%;
    /* background-color: rgb(242, 242, 242); */
    border-radius: 20px;
    overflow: hidden;
    justify-content: center;
    flex-direction: column;
    aling-items:center;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    background-image: url("project://database/Assets/Imgs/PopUpImgs/PopUpPanels.png#PopUp");
}

.icon {
    font-size: 120px;
    color: white;
    unity-font-style: bold;
}

.card-header {
    height: 30%;
    /* background-color: rgb(123, 192, 67); */
    justify-content: center;
    align-items: center;
    border-bottom-left-radius: 50% 30%;
    border-bottom-right-radius: 50% 30%;
}

.card-body {
    padding: 20px;
    height: 70%;
    width: 83%;
    margin-bottom: 40px;
    align-items: center;
    align-self:center;
    justify-content: space-between;
}

.title {
    font-size: 65px;
    unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
}

.message {
    font-size: 45px;
    color: rgb(182, 245, 253);
    text-align: center;
    margin-bottom: 20px;
    white-space: normal;
    -unity-text-align: upper-center;
}

.buttonPop {
    width: 60%;
    height: 24%;
    color: white;
    border-radius: 30px;
    unity-font-style: bold;
    font-size: 55px;
    border-width: 0;
    background-color: rgba(1,1,1,0);
    background-image: url("project://database/Assets/Imgs/ButtonAnim.png#Accept");
}

.buttonPop:hover {
    background-color: rgba(142, 220, 79,0);
    background-image: url("project://database/Assets/Imgs/ButtonAnim.png#AcceptPush");
}
