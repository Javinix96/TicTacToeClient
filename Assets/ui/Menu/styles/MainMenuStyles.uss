.container3 {
    background-color: rgb(11, 18, 32);
    padding: 12px;
    justify-content: flex-start;
    flex-grow: 1;
    background-image: url("project://database/Assets/Imgs/BackGround.png#Tablero futurista de tic-tac-toe_0");
}

.content {
    align-items: center;
    height: 100%;
    justify-content: space-evenly;
}

.title {
    font-size: 128px;
    unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.subtitle {
    font-size: 60px;
    color: rgb(224, 247, 255);
    margin-bottom: 20px;
    white-space: pre-wrap;
    -unity-text-align: upper-center;
}

.btn {
    width: 80%;
    height: 13%;
    border-radius: 20px;
    unity-text-align: middle-center;
    font-size: 78px;
    justify-content: center;
    unity-font-style: bold;
    transition: scale 0.1s;
}

.btn:hover {
    scale: 1.05;
}

.btn-blue {
    background-color: rgba(62, 193, 211, 0);
    border-width: 0;
    background-image: url("project://database/Assets/Imgs/Menu/MenuGame.png#Single");
}

.btn-blue:hover {
    background-image: url("project://database/Assets/Imgs/Menu/MenuGame.png#SinglePush");
}

.btn-orange {
    background-color: rgba(255, 122, 0,0);
    border-width: 0;
    background-image: url("project://database/Assets/Imgs/Menu/MenuGame.png#Multiplayer");
}

.btn-orange:hover {
    background-color: rgba(255, 122, 0,0);
    border-width: 0;
    background-image: url("project://database/Assets/Imgs/Menu/MenuGame.png#MultiplayerPush");
}

.footer {
    position: absolute;
    bottom: 20px;
    flex-direction: row;
    gap: 20px;
}

.icon-btn {
    width: 50px;
    height: 50px;
    border-radius: 50px;
    background-color: rgba(255, 255, 255, 0.2);
    font-size: 20px;
    unity-text-align: middle-center;
}
.title {
    flex-direction: row;
    margin-top: 20px;
    justify-content: space-evenly;
    align-items: center;
    width: 100%;
    height: 10%;
}

.title > Label {
    font-size: 128px;
    -unity-font-style: bold;
    padding: 0;
}

.blue {
    color: rgb(30, 144, 255);
}

.white {
    color: white;
}

.red {
    color: rgb(255, 69, 0);
}

