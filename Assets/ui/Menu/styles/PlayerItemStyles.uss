.container2 {
    background-color: rgba(16, 28, 65, 0.7);
    height: 170px;
    width: 100%;
    border-radius: 10px;
    flex-direction: row;
    align-items: center;
    justify-Content: space-between;
    margin-bottom: 10px;
}

.icon {
    background-color: rgb(210, 235, 22);
    width: 15%;
    height: 54%;
    border-radius: 15px;
    align-items: center;
    justify-Content:center;
    padding: 0;
    margin-left: 2px;
    font-size: 40px;
}


.player-name{
    color: white;
    font-size: 34px;
    flex-grow:1;
    margin-left: 10px;
}

.indicator{
    background-color: rgba(10, 103, 47, 0.8);
    margin-right: 5px;
    border-radius: 9px;
    height: 55%;
    justify-content: center;
    align-items:center;
    padding:0;
    width: 25%;
}

.indicator Label{
    color: rgb(39, 226, 111);
    font-size: 26px;
    padding:0;
    padding-right: 2px;
    margin:0;
}

.tag{
    background-image: url("project://database/Assets/ui/Menu/svg/cross3.svg");
    width: 68%;
    height: 90%;
}
