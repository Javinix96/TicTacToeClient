<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/ui/Menu/styles/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=e41114c352273ca4393f3da44d46ad57&amp;type=3#MainMenuStyles"/>
    <ui:VisualElement name="MainMenu" class="container3">
        <ui:VisualElement name="Content" class="content">
            <ui:VisualElement name="Title" class="title">
                <ui:Label text="TIC" name="Tic" class="blue"/>
                <ui:Label text="TAC" name="Tac" class="white"/>
                <ui:Label text="TOE" name="Toe" class="red"/>
            </ui:VisualElement>
            <ui:Label text="Elige tu modo y comienza la aventura" class="subtitle"/>
            <ui:Button name="btnSingle" class="btn btn-blue">
                <!-- <ui:VisualElement name="Content" class="single-svg" /> -->
                <!-- <ui:Label /> -->
            </ui:Button>
            <ui:Button name="btnMulti" class="btn btn-orange">
                <!-- <ui:VisualElement name="Content" class="online-svg" /> -->
                <!-- <ui:Label /> -->
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer"/>
    </ui:VisualElement>
</ui:UXML>
